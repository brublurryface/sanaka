# Local: acesso direto ao Node. No Render, conferir os proxies antes de usar o valor 1.
TRUST_PROXY_HOPS=0
# Na homologação pública do Render, usar true; retirar o bloqueio ao lançar o domínio definitivo.
SITE_NOINDEX=false

SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=sanaka@sanaka.com.br
SMTP_PASS=replace-with-the-hosting-secret
CONTACT_FROM_EMAIL=Sanaka <sanaka@sanaka.com.br>
CONTACT_TO_EMAIL=sanaka@sanaka.com.br

# Newsletter: configure somente no processo Node, nunca no navegador ou no Git.
# Valores vazios mantêm as inscrições indisponíveis sem impedir o site de abrir.
BREVO_API_KEY=
BREVO_NEWSLETTER_LIST_ID=
BREVO_NEWSLETTER_TEMPLATE_ID=
BREVO_NEWSLETTER_REDIRECT_URL=
