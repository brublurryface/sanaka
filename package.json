{
  "name": "sanaka",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false",
    "test:server": "vitest run --config vitest.server.config.ts --coverage",
    "test:coverage": "ng test --watch=false --coverage --coverage-include=src/app/**/*.ts --coverage-exclude=src/app/**/*.routes.ts --coverage-reporters=text-summary --coverage-reporters=json-summary && node scripts/check-coverage.mjs",
    "duplication:check": "jscpd src/app --format typescript --min-lines 5 --min-tokens 50 --ignore \"**/*.spec.ts\" --threshold 3 --reporters console",
    "duplication:report": "jscpd src/app --min-lines 5 --min-tokens 50 --ignore **/*.spec.ts --reporters console",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit:dependencies": "npm audit --audit-level=moderate",
    "matrix:source:sync": "node scripts/matrix-study-source.mjs",
    "matrix:source:check": "node scripts/matrix-study-source.mjs --check",
    "check": "npm run audit:dependencies && npm run matrix:source:check && npm run format:check && npm run test:server && npm run test:coverage && npm run duplication:check && npm run build",
    "serve:ssr:sanaka": "node dist/sanaka/server/server.mjs"
  },
  "private": true,
  "engines": {
    "node": "^24.15.0"
  },
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@angular/cdk": "^22.2.6",
    "@angular/common": "^22.2.4",
    "@angular/compiler": "^22.2.4",
    "@angular/core": "^22.2.4",
    "@angular/forms": "^22.2.4",
    "@angular/material": "^22.2.6",
    "@angular/platform-browser": "^22.2.4",
    "@angular/platform-server": "^22.2.4",
    "@angular/router": "^22.2.4",
    "@angular/ssr": "^22.2.6",
    "@jsverse/transloco": "^8.4.0",
    "express": "^5.3.0",
    "nodemailer": "^10.3.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.4",
    "@angular/platform-browser-dynamic": "^22.2.4",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "@types/nodemailer": "^8.0.2",
    "@vitest/coverage-v8": "^4.1.12",
    "jscpd": "^5.3.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.1.12"
  }
}
